# ==============================================================================
# Multi-Tenant School ERP — Environment Variables Template
# ==============================================================================
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and provide your actual credentials.

# Database Connections (PostgreSQL via Supabase or Local)
# Pooled connection string (for serverless / app runtime)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require&pgbouncer=true"
# Direct connection string (for migrations and Prisma CLI)
DIRECT_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Application Settings
NEXT_PUBLIC_APP_NAME="School ERP SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication & Session Security (Minimum 32 random characters)
AUTH_SECRET="your-super-secret-random-32-character-auth-key-change-me"
SESSION_MAX_AGE="86400"

# Redis Cache & Background Tasks (Upstash Redis for $0 tier)
UPSTASH_REDIS_REST_URL="https://[YOUR-PROJECT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-TOKEN]"

# Private Storage (Supabase Storage / Cloudflare R2 - Signed URLs only)
STORAGE_BUCKET_NAME="school-erp-private"
STORAGE_ENDPOINT="https://[YOUR-PROJECT].supabase.co/storage/v1/s3"
STORAGE_ACCESS_KEY_ID="[STORAGE-ACCESS-KEY]"
STORAGE_SECRET_ACCESS_KEY="[STORAGE-SECRET-KEY]"
STORAGE_REGION="auto"
