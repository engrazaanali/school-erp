// Prisma Schema for Multi-Tenant School ERP SaaS
// Supports strict multi-tenancy, defense-in-depth RLS, granular RBAC, and immutable audit logs.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Baseline system health model for infrastructure validation & uptime monitoring
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("HEALTHY")
  note      String?
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("system_health")
}

// ==============================================================================
// 1. TENANT & CAMPUS FOUNDATION
// ==============================================================================

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  code      String    @unique
  status    String    @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relationships
  settings     OrganizationSettings?
  campuses     Campus[]
  people       Person[]
  users        User[]
  roles        Role[]
  assignments  Assignment[]
  auditLogs    AuditLog[]
  files        FileRecord[]
  families           Family[]
  familyMembers      FamilyMember[]
  parents            Parent[]
  students           Student[]
  studentGuardians   StudentGuardian[]
  staff              Staff[]
  teachers           Teacher[]
  admissionInquiries AdmissionInquiry[]
  admissions         Admission[]
  academicYears      AcademicYear[]
  academicTerms      AcademicTerm[]
  classes            Class[]
  sections           Section[]
  subjects           Subject[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  feeHeads           FeeHead[]
  feeStructures      FeeStructure[]
  studentFeeAssignments StudentFeeAssignment[]
  feeInvoices        FeeInvoice[]
  discounts          Discount[]
  lateFeeRules       LateFeeRule[]
  payments           Payment[]
  receipts           Receipt[]
  refunds            Refund[]

  @@index([slug])
  @@index([code])
  @@index([status])
  @@map("organizations")
}

model OrganizationSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique @map("organization_id")
  logoUrl        String?      @map("logo_url")
  primaryColor   String?      @default("#2563eb") @map("primary_color")
  secondaryColor String?      @default("#1e40af") @map("secondary_color")
  timezone       String       @default("UTC")
  currency       String       @default("USD")
  dateFormat     String       @default("YYYY-MM-DD") @map("date_format")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model Campus {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  name           String
  code           String
  status         String          @default("ACTIVE") // ACTIVE, INACTIVE
  address        String?
  city           String?
  phone          String?
  email          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings       CampusSettings?
  assignments    Assignment[]
  auditLogs      AuditLog[]
  files          FileRecord[]
  students           Student[]
  staff              Staff[]
  teachers           Teacher[]
  admissionInquiries AdmissionInquiry[]
  admissions         Admission[]
  academicYears      AcademicYear[]
  academicTerms      AcademicTerm[]
  classes            Class[]
  sections           Section[]
  subjects           Subject[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  leaveRequests      LeaveRequest[]
  feeHeads           FeeHead[]
  feeStructures      FeeStructure[]
  studentFeeAssignments StudentFeeAssignment[]
  feeInvoices        FeeInvoice[]
  discounts          Discount[]
  lateFeeRules       LateFeeRule[]
  payments           Payment[]
  receipts           Receipt[]
  refunds            Refund[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("campuses")
}

model CampusSettings {
  id                 String   @id @default(uuid())
  campusId           String   @unique @map("campus_id")
  academicStartMonth Int      @default(1) @map("academic_start_month")
  workingDays        String   @default("MON,TUE,WED,THU,FRI") @map("working_days")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  campus             Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@map("campus_settings")
}

// ==============================================================================
// 2. IDENTITY: PERSON -> USER ACCOUNT -> ROLES -> ASSIGNMENTS
// ==============================================================================

model Person {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  email          String?
  phone          String?
  nationalId     String?      @map("national_id")
  gender         String?
  dateOfBirth    DateTime?    @map("date_of_birth")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  familyMembers  FamilyMember[]
  parentProfile  Parent?
  studentProfile Student?
  staffProfile   Staff?

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("people")
}

model User {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  personId        String       @map("person_id")
  email           String
  passwordHash    String       @map("password_hash")
  status          String       @default("ACTIVE") // ACTIVE, DISABLED, PENDING_INVITE
  emailVerifiedAt DateTime?    @map("email_verified_at")
  lastLoginAt     DateTime?    @map("last_login_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person          Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  sessions        Session[]
  userRoles       UserRole[]
  assignments     Assignment[]
  auditLogs       AuditLog[]
  uploadedFiles   FileRecord[]
  fileAccessLogs  FileAccessLog[]
  attendanceSessionsTaken AttendanceSession[]
  leaveRequestsApproved   LeaveRequest[]
  paymentsReceived        Payment[]
  refundsProcessed        Refund[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([personId])
  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// ==============================================================================
// 3. RBAC (ROLES, PERMISSIONS, ROLE_PERMISSIONS, USER_ROLES)
// ==============================================================================

model Role {
  id             String           @id @default(uuid())
  organizationId String?          @map("organization_id") // Null for global/platform default roles
  name           String
  slug           String
  description    String?
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles      UserRole[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String
  code        String           @unique // e.g. "organizations.read", "students.create"
  module      String           // organizations, campuses, users, roles, students, fees, etc.
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([code])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ==============================================================================
// 4. ASSIGNMENTS & SCOPING (ORGANIZATION, CAMPUS, DEPT, CLASS, SECTION, SUBJECT)
// ==============================================================================

model Assignment {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  campusId       String?      @map("campus_id")
  scopeType      String       @map("scope_type") // ORGANIZATION, CAMPUS, DEPARTMENT, CLASS, SECTION, SUBJECT
  scopeId        String?      @map("scope_id")   // Target ID for Class, Section, Department, or Subject
  isPrimary      Boolean      @default(false) @map("is_primary")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([campusId])
  @@index([scopeType, scopeId])
  @@map("assignments")
}

// ==============================================================================
// 5. AUDIT LOGGING & PRIVATE FILES
// ==============================================================================

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String?      @map("campus_id")
  userId         String?      @map("user_id")
  action         String       // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, VIEW, EXPORT
  resource       String       // ORGANIZATION, CAMPUS, USER, ROLE, ASSIGNMENT, etc.
  resourceId     String?      @map("resource_id")
  oldValues      Json?        @map("old_values")
  newValues      Json?        @map("new_values")
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campusId])
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FileRecord {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  campusId       String?         @map("campus_id")
  uploadedById   String?         @map("uploaded_by_id")
  fileName       String          @map("file_name")
  mimeType       String          @map("mime_type")
  fileSize       Int             @map("file_size")
  storageKey     String          @unique @map("storage_key")
  bucketName     String          @map("bucket_name")
  isPrivate      Boolean         @default(true) @map("is_private")
  createdAt      DateTime        @default(now()) @map("created_at")
  deletedAt      DateTime?       @map("deleted_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  uploadedBy     User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  accessLogs     FileAccessLog[]
  admissionDocuments AdmissionDocument[]

  @@index([organizationId])
  @@index([campusId])
  @@index([storageKey])
  @@map("files")
}

model FileAccessLog {
  id         String     @id @default(uuid())
  fileId     String     @map("file_id")
  userId     String?    @map("user_id")
  ipAddress  String?    @map("ip_address")
  accessedAt DateTime   @default(now()) @map("accessed_at")

  file       FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fileId])
  @@index([accessedAt])
  @@map("file_access_logs")
}

// ==============================================================================
// 6. PHASE 3: PEOPLE, FAMILIES, STUDENTS & STAFF
// ==============================================================================

model Family {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  familyCode          String            @map("family_code")
  familyName          String            @map("family_name")
  primaryContactName  String?           @map("primary_contact_name")
  primaryContactPhone String?           @map("primary_contact_phone")
  primaryContactEmail String?           @map("primary_contact_email")
  address             String?
  city                String?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")

  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  familyMembers       FamilyMember[]
  studentGuardians    StudentGuardian[]

  @@unique([organizationId, familyCode])
  @@index([organizationId])
  @@map("families")
}

model FamilyMember {
  id               String       @id @default(uuid())
  organizationId   String       @map("organization_id")
  familyId         String       @map("family_id")
  personId         String       @map("person_id")
  relationship     String       // FATHER, MOTHER, GUARDIAN, SIBLING, OTHER
  isPrimaryContact Boolean      @default(false) @map("is_primary_contact")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  family           Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person           Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([familyId, personId])
  @@index([organizationId])
  @@index([familyId])
  @@index([personId])
  @@map("family_members")
}

model Parent {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  personId         String            @unique @map("person_id")
  occupation       String?
  employer         String?
  annualIncome     Decimal?          @map("annual_income") @db.Decimal(12, 2)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person           Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  studentGuardians StudentGuardian[]

  @@index([organizationId])
  @@map("parents")
}

model Student {
  id                    String            @id @default(uuid())
  organizationId        String            @map("organization_id")
  campusId              String            @map("campus_id")
  personId              String            @unique @map("person_id")
  admissionNumber       String            @map("admission_number")
  studentNumber         String?           @map("student_number")
  admissionDate         DateTime          @default(now()) @map("admission_date")
  status                String            @default("ACTIVE") // ACTIVE, GRADUATED, WITHDRAWN, SUSPENDED
  bloodGroup            String?           @map("blood_group")
  emergencyContactName  String?           @map("emergency_contact_name")
  emergencyContactPhone String?           @map("emergency_contact_phone")
  medicalNotes          String?           @map("medical_notes")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus                Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  person                Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  studentGuardians      StudentGuardian[]
  admissions            Admission[]
  enrollments           StudentEnrollment[]
  attendanceRecords     AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  feeAssignments        StudentFeeAssignment[]
  feeInvoices           FeeInvoice[]
  studentDiscounts      StudentDiscount[]
  payments              Payment[]
  refunds               Refund[]

  @@unique([organizationId, admissionNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([status])
  @@map("students")
}

model StudentGuardian {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  studentId      String       @map("student_id")
  parentId       String?      @map("parent_id")
  familyId       String?      @map("family_id")
  relationship   String       // FATHER, MOTHER, GUARDIAN, SPONSOR
  isPrimary      Boolean      @default(false) @map("is_primary")
  canPickup      Boolean      @default(true) @map("can_pickup")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent         Parent?      @relation(fields: [parentId], references: [id], onDelete: SetNull)
  family         Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@unique([studentId, parentId])
  @@index([organizationId])
  @@index([studentId])
  @@index([parentId])
  @@index([familyId])
  @@map("student_guardians")
}

model Staff {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  personId       String       @unique @map("person_id")
  employeeNumber String       @map("employee_number")
  designation    String
  department     String?
  joiningDate    DateTime     @default(now()) @map("joining_date")
  status         String       @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED, RESIGNED
  employmentType String       @default("FULL_TIME") @map("employment_type") // FULL_TIME, PART_TIME, CONTRACT
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  teacher        Teacher?

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([status])
  @@map("staff")
}

model Teacher {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  staffId        String       @unique @map("staff_id")
  specialization String?
  qualification  String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  assignments    TeacherAssignment[]
  timetableEntries TimetableEntry[]

  @@index([organizationId])
  @@index([campusId])
  @@map("teachers")
}

model AdmissionInquiry {
  id               String              @id @default(uuid())
  organizationId   String              @map("organization_id")
  campusId         String              @map("campus_id")
  inquiryNumber    String              @map("inquiry_number")
  studentFirstName String              @map("student_first_name")
  studentLastName  String              @map("student_last_name")
  gender           String?
  dateOfBirth      DateTime?           @map("date_of_birth")
  gradeApplying    String              @map("grade_applying")
  parentName       String              @map("parent_name")
  parentPhone      String              @map("parent_phone")
  parentEmail      String?             @map("parent_email")
  status           String              @default("INQUIRY") // INQUIRY, CONTACTED, TEST_SCHEDULED, OFFERED, ADMITTED, REJECTED, CANCELLED
  source           String?             // WEBSITE, REFERRAL, WALK_IN, SOCIAL_MEDIA
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  deletedAt        DateTime?           @map("deleted_at")

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus           Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  followups        AdmissionFollowup[]
  admission        Admission?

  @@unique([organizationId, inquiryNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([status])
  @@map("admission_inquiries")
}

model AdmissionFollowup {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  inquiryId        String           @map("inquiry_id")
  followupDate     DateTime         @default(now()) @map("followup_date")
  contactType      String           @map("contact_type") // PHONE_CALL, EMAIL, MEETING, WHATSAPP
  responseNotes    String           @map("response_notes")
  nextFollowupDate DateTime?        @map("next_followup_date")
  performedBy      String?          @map("performed_by")
  createdAt        DateTime         @default(now()) @map("created_at")

  inquiry          AdmissionInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([organizationId])
  @@map("admission_followups")
}

model Admission {
  id                String              @id @default(uuid())
  organizationId    String              @map("organization_id")
  campusId          String              @map("campus_id")
  inquiryId         String?             @unique @map("inquiry_id")
  studentId         String              @map("student_id")
  applicationNumber String              @map("application_number")
  gradeEnrolled     String              @map("grade_enrolled")
  academicYear      String              @map("academic_year")
  admissionDate     DateTime            @default(now()) @map("admission_date")
  status            String              @default("ENROLLED") // SUBMITTED, APPROVED, ENROLLED, CANCELLED
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  deletedAt         DateTime?           @map("deleted_at")

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus            Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  inquiry           AdmissionInquiry?   @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents         AdmissionDocument[]

  @@unique([organizationId, applicationNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([studentId])
  @@map("admissions")
}

model AdmissionDocument {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  admissionId    String       @map("admission_id")
  fileId         String       @map("file_id")
  documentType   String       @map("document_type") // BIRTH_CERTIFICATE, PREVIOUS_TRANSCRIPT, ID_PROOF, MEDICAL_RECORD, OTHER
  isVerified     Boolean      @default(false) @map("is_verified")
  verifiedAt     DateTime?    @map("verified_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  admission      Admission    @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  file           FileRecord   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([admissionId])
  @@index([fileId])
  @@map("admission_documents")
}

// ==============================================================================
// 7. PHASE 4: ACADEMIC CORE & DAILY ATTENDANCE
// ==============================================================================

model AcademicYear {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  campusId           String              @map("campus_id")
  name               String              // e.g. "2026-2027"
  code               String              // e.g. "AY-26-27"
  startDate          DateTime            @map("start_date")
  endDate            DateTime            @map("end_date")
  isCurrent          Boolean             @default(false) @map("is_current")
  status             String              @default("ACTIVE") // ACTIVE, CLOSED, PLANNED
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  terms              AcademicTerm[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  feeStructures      FeeStructure[]
  studentFeeAssignments StudentFeeAssignment[]
  feeInvoices        FeeInvoice[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@index([campusId])
  @@map("academic_years")
}

model AcademicTerm {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  academicYearId String       @map("academic_year_id")
  name           String       // e.g. "Term 1"
  code           String       // e.g. "T1"
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  isCurrent      Boolean      @default(false) @map("is_current")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, code])
  @@index([organizationId])
  @@index([campusId])
  @@map("academic_terms")
}

model Class {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  campusId           String              @map("campus_id")
  name               String              // e.g. "Grade 1"
  code               String              // e.g. "G1"
  stage              String?             // PRIMARY, MIDDLE, SECONDARY, HIGHER_SECONDARY
  order              Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  sections           Section[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]
  feeStructures      FeeStructure[]
  studentFeeAssignments StudentFeeAssignment[]
  feeInvoices        FeeInvoice[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@index([campusId])
  @@map("classes")
}

model Section {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  campusId           String              @map("campus_id")
  classId            String              @map("class_id")
  name               String              // e.g. "Section A"
  code               String              // e.g. "A"
  capacity           Int                 @default(30)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  studentEnrollments StudentEnrollment[]
  timetables         Timetable[]
  attendanceSessions AttendanceSession[]

  @@unique([classId, code])
  @@index([organizationId])
  @@index([campusId])
  @@map("sections")
}

model Subject {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  campusId           String              @map("campus_id")
  name               String              // e.g. "Mathematics"
  code               String              // e.g. "MATH"
  type               String              @default("THEORY") // THEORY, PRACTICAL, BOTH
  creditHours        Decimal?            @map("credit_hours") @db.Decimal(4, 2)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus             Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@index([campusId])
  @@map("subjects")
}

model ClassSubject {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  classId        String       @map("class_id")
  subjectId      String       @map("subject_id")
  isElective     Boolean      @default(false) @map("is_elective")
  passingMarks   Decimal?     @map("passing_marks") @db.Decimal(5, 2)
  totalMarks     Decimal?     @map("total_marks") @db.Decimal(5, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([organizationId])
  @@map("class_subjects")
}

model TeacherAssignment {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  campusId       String        @map("campus_id")
  academicYearId String        @map("academic_year_id")
  classId        String        @map("class_id")
  sectionId      String        @map("section_id")
  subjectId      String?       @map("subject_id") // Null for Class Teacher
  teacherId      String        @map("teacher_id")
  isClassTeacher Boolean       @default(false) @map("is_class_teacher")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher        Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([campusId])
  @@index([academicYearId])
  @@index([classId, sectionId])
  @@index([teacherId])
  @@map("teacher_assignments")
}

model StudentEnrollment {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  academicYearId String       @map("academic_year_id")
  studentId      String       @map("student_id")
  classId        String       @map("class_id")
  sectionId      String       @map("section_id")
  rollNumber     String?      @map("roll_number")
  status         String       @default("ACTIVE") // ACTIVE, PROMOTED, REPEATING, TRANSFERRED, DROPPED
  enrollmentDate DateTime     @default(now()) @map("enrollment_date")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentId])
  @@index([organizationId])
  @@index([campusId])
  @@index([classId, sectionId])
  @@index([studentId])
  @@map("student_enrollments")
}

model Timetable {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  campusId       String           @map("campus_id")
  academicYearId String           @map("academic_year_id")
  classId        String           @map("class_id")
  sectionId      String           @map("section_id")
  name           String           // e.g. "Standard Timetable 2026"
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  entries        TimetableEntry[]

  @@index([organizationId])
  @@index([campusId])
  @@index([classId, sectionId])
  @@map("timetables")
}

model TimetableEntry {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  timetableId    String       @map("timetable_id")
  dayOfWeek      String       // MON, TUE, WED, THU, FRI, SAT, SUN
  startTime      String       // "08:30"
  endTime        String       // "09:15"
  subjectId      String       @map("subject_id")
  teacherId      String?      @map("teacher_id")
  room           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  timetable      Timetable    @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([timetableId])
  @@index([dayOfWeek])
  @@map("timetable_entries")
}

model AttendanceSession {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  campusId       String             @map("campus_id")
  academicYearId String             @map("academic_year_id")
  classId        String             @map("class_id")
  sectionId      String             @map("section_id")
  date           DateTime           @db.Date
  takenById      String?            @map("taken_by_id")
  status         String             @default("SUBMITTED")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  section        Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  takenBy        User?              @relation(fields: [takenById], references: [id], onDelete: SetNull)
  records        AttendanceRecord[]

  @@unique([classId, sectionId, date])
  @@index([organizationId])
  @@index([campusId])
  @@index([date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  sessionId      String            @map("session_id")
  studentId      String            @map("student_id")
  status         String            // PRESENT, ABSENT, LATE, LEAVE
  remarks        String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session        AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([organizationId])
  @@index([studentId])
  @@index([status])
  @@map("attendance_records")
}

model LeaveRequest {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  studentId      String       @map("student_id")
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  reason         String
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById   String?      @map("approved_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  approvedBy     User?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campusId])
  @@index([studentId])
  @@map("leave_requests")
}

// ==============================================================================
// 8. PHASE 5: FEE ENGINE, CHALLANS, RECEIPTS & PAYMENTS (MVP COMPLETE)
// ==============================================================================

model FeeHead {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  campusId       String             @map("campus_id")
  name           String             // e.g. "Tuition Fee", "Admission Fee", "Transport Fee", "Laboratory Fee"
  code           String             // e.g. "TUIT", "ADM", "TRANS"
  type           String             @default("RECURRING") // RECURRING, ONE_TIME, OPTIONAL
  description    String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  structureItems FeeStructureItem[]
  invoiceItems   FeeInvoiceItem[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@index([campusId])
  @@map("fee_heads")
}

model FeeStructure {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  campusId       String             @map("campus_id")
  academicYearId String             @map("academic_year_id")
  classId        String?            @map("class_id") // Null for global/cross-class structure
  name           String             // e.g. "Grade 1 Standard Fee 2026-2027"
  frequency      String             @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUALLY, ONE_TIME
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class?             @relation(fields: [classId], references: [id], onDelete: Cascade)
  items          FeeStructureItem[]
  assignments    StudentFeeAssignment[]

  @@index([organizationId])
  @@index([campusId])
  @@index([academicYearId])
  @@index([classId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id             String       @id @default(uuid())
  feeStructureId String       @map("fee_structure_id")
  feeHeadId      String       @map("fee_head_id")
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead        FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)

  @@unique([feeStructureId, feeHeadId])
  @@index([feeStructureId])
  @@index([feeHeadId])
  @@map("fee_structure_items")
}

model StudentFeeAssignment {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  studentId      String       @map("student_id")
  feeStructureId String       @map("fee_structure_id")
  academicYearId String       @map("academic_year_id")
  classId        String?      @map("class_id")
  customAmount   Decimal?     @map("custom_amount") @db.Decimal(12, 2) // Override structure amount if set
  status         String       @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([studentId, feeStructureId, academicYearId])
  @@index([organizationId])
  @@index([campusId])
  @@index([studentId])
  @@index([feeStructureId])
  @@map("student_fee_assignments")
}

model Discount {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  campusId       String            @map("campus_id")
  name           String            // e.g. "Sibling Discount", "Staff Child Concession", "Merit Scholarship"
  code           String            // e.g. "SIBLING_20", "STAFF_CONCESSION"
  type           String            @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  value          Decimal           @db.Decimal(12, 2) // e.g. 20.00 for 20% or 500.00 for fixed
  description    String?
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus            @relation(fields: [campusId], references: [id], onDelete: Cascade)
  studentDiscounts StudentDiscount[]

  @@unique([campusId, code])
  @@index([organizationId])
  @@index([campusId])
  @@map("discounts")
}

model StudentDiscount {
  id             String       @id @default(uuid())
  studentId      String       @map("student_id")
  discountId     String       @map("discount_id")
  reason         String?
  startDate      DateTime     @default(now()) @map("start_date")
  endDate        DateTime?    @map("end_date")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now()) @map("created_at")

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  discount       Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([studentId, discountId])
  @@index([studentId])
  @@index([discountId])
  @@map("student_discounts")
}

model LateFeeRule {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  name           String       // e.g. "Standard Late Fee"
  graceDays      Int          @default(10) @map("grace_days")
  type           String       @default("DAILY") // DAILY, FIXED_ONE_TIME, PERCENTAGE
  amount         Decimal      @db.Decimal(12, 2) // Daily rate or one-off fixed rate
  maxAmount      Decimal?     @map("max_amount") @db.Decimal(12, 2)
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([campusId])
  @@map("late_fee_rules")
}

model FeeInvoice {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  campusId       String              @map("campus_id")
  studentId      String              @map("student_id")
  academicYearId String              @map("academic_year_id")
  classId        String?             @map("class_id")
  invoiceNumber  String              @map("invoice_number") // Challan number e.g. "CH-2026-0001"
  title          String              // e.g. "Tuition Fee - October 2026"
  issueDate      DateTime            @default(now()) @map("issue_date") @db.Date
  dueDate        DateTime            @map("due_date") @db.Date
  subtotal       Decimal             @db.Decimal(12, 2)
  discountAmount Decimal             @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  lateFeeAmount  Decimal             @default(0.00) @map("late_fee_amount") @db.Decimal(12, 2)
  arrearsAmount  Decimal             @default(0.00) @map("arrears_amount") @db.Decimal(12, 2)
  totalAmount    Decimal             @map("total_amount") @db.Decimal(12, 2)
  paidAmount     Decimal             @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount  Decimal             @map("balance_amount") @db.Decimal(12, 2)
  status         String              @default("UNPAID") // UNPAID, PARTIAL, PAID, OVERDUE, VOID, CANCELLED
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  items          FeeInvoiceItem[]
  allocations    PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
  @@index([dueDate])
  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id             String       @id @default(uuid())
  invoiceId      String       @map("invoice_id")
  feeHeadId      String       @map("fee_head_id")
  description    String?
  amount         Decimal      @db.Decimal(12, 2)
  createdAt      DateTime     @default(now()) @map("created_at")

  invoice        FeeInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead        FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([feeHeadId])
  @@map("fee_invoice_items")
}

model Payment {
  id              String              @id @default(uuid())
  organizationId  String              @map("organization_id")
  campusId        String              @map("campus_id")
  studentId       String              @map("student_id")
  paymentNumber   String              @map("payment_number") // e.g. "PAY-2026-0001"
  paymentDate     DateTime            @default(now()) @map("payment_date")
  amount          Decimal             @db.Decimal(12, 2)
  paymentMethod   String              @default("CASH") @map("payment_method") // CASH, BANK_TRANSFER, ONLINE, CHEQUE, POS
  referenceNumber String?             @map("reference_number") // Cheque/bank transaction ID
  receivedById    String?             @map("received_by_id")
  status          String              @default("COMPLETED") // COMPLETED, REVERSED, REFUNDED, FAILED
  remarks         String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus          Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receivedBy      User?               @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]
  receipts        Receipt[]
  refunds         Refund[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([studentId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

model PaymentAllocation {
  id             String       @id @default(uuid())
  paymentId      String       @map("payment_id")
  invoiceId      String       @map("invoice_id")
  allocatedAmount Decimal     @map("allocated_amount") @db.Decimal(12, 2)
  createdAt      DateTime     @default(now()) @map("created_at")

  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice        FeeInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model Receipt {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  paymentId      String       @map("payment_id")
  receiptNumber  String       @map("receipt_number") // e.g. "REC-2026-0001"
  accessToken    String       @unique @map("access_token") // Secure unguessable token for public view & WhatsApp link
  issuedDate     DateTime     @default(now()) @map("issued_date")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([paymentId])
  @@index([accessToken])
  @@map("receipts")
}

model Refund {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  campusId       String       @map("campus_id")
  paymentId      String       @map("payment_id")
  studentId      String       @map("student_id")
  refundNumber   String       @map("refund_number") // e.g. "REF-2026-0001"
  amount         Decimal      @db.Decimal(12, 2)
  reason         String
  processedById  String?      @map("processed_by_id")
  status         String       @default("COMPLETED") // COMPLETED, REJECTED
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus         Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  processedBy    User?        @relation(fields: [processedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, refundNumber])
  @@index([organizationId])
  @@index([campusId])
  @@index([paymentId])
  @@index([studentId])
  @@map("refunds")
}



